{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/distiller.schema.json",
  "title": "Reasoning Distiller Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "$defs": {
    "sourceList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "primary": {"$ref": "#/$defs/sourceList"},
        "authority": {"$ref": "#/$defs/sourceList"},
        "corroborating": {"$ref": "#/$defs/sourceList"},
        "context": {"$ref": "#/$defs/sourceList"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temp_id", "kind", "statement", "epistemic_role"],
      "properties": {
        "temp_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["observation", "decision", "assumption", "uncertainty", "claim"]},
        "statement": {"type": "string", "minLength": 1},
        "epistemic_role": {"enum": ["axiom", "derived", "unresolved"]},
        "authority": {"enum": ["owner", "governed"]},
        "premise": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"epistemic_role": {"const": "derived"}}, "required": ["epistemic_role"]},
          "then": {"required": ["premise"]},
          "else": {"not": {"required": ["premise"]}}
        },
        {
          "if": {"required": ["authority"]},
          "then": {
            "required": ["provenance"],
            "properties": {"provenance": {"required": ["authority"]}}
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "observation"},
              "epistemic_role": {"const": "axiom"}
            },
            "required": ["kind", "epistemic_role"]
          },
          "then": {
            "required": ["provenance"],
            "properties": {"provenance": {"required": ["primary"]}}
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "type": {"enum": ["supports", "contradicts", "depends_on", "supersedes", "validated_by"]},
        "to": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
